  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerAddress, agentKey], map: "cli_agent_wallets_owner_agent_key_uidx")
  @@index([ownerAddress], map: "cli_agent_wallets_owner_idx")
  @@map("cli_agent_wallets")
  @@schema("cobuild")
}

model CliTxLog {
  id           BigInt   @id @default(autoincrement())
  ownerAddress String   @map("owner_address") @db.VarChar(42)
